      "FinalRequestProcessing": {
        "enabled": true,
        "script": "({ request }) => {\n  const marker = '<run_tool_replacement>';\n  const messages = request.messages;\n  if (!Array.isArray(messages)) return request;\n\n  const toText = content => Array.isArray(content)\n    ? content\n        .map(part => typeof part === 'string' ? part : part?.text ?? '')\n        .join('\\n')\n    : String(content ?? '');\n\n  if (!messages.some(\n    message => message?.role === 'system' &&\n      toText(message.content).includes(marker)\n  )) {\n    return request;\n  }\n\n  if (\n    messages.length !== 3 ||\n    messages[0]?.role !== 'system' ||\n    messages[1]?.role !== 'assistant' ||\n    messages[2]?.role !== 'user'\n  ) {\n    throw new Error('预期消息为三条：system → assistant → user');\n  }\n\n  const [system, assistant, user] = messages;\n\n  const consumeMarker = content => {\n    if (typeof content === 'string') {\n      return content.replaceAll(marker, '');\n    }\n    if (Array.isArray(content)) {\n      return content.map(part =>\n        typeof part === 'string'\n          ? part.replaceAll(marker, '')\n          : typeof part?.text === 'string'\n            ? { ...part, text: part.text.replaceAll(marker, '') }\n            : part\n      );\n    }\n    return content;\n  };\n\n  request.tools = [\n    ...(request.tools ?? []).filter(\n      tool => !(tool.type === 'function' && tool.function?.name === 'context')\n    ),\n    {\n      type: 'function',\n      function: {\n        name: 'context',\n        description: toText(assistant.content),\n        parameters: {\n          type: 'object',\n          properties: {},\n        },\n      },\n    },\n  ];\n\n  request.messages = [\n    { ...system, content: consumeMarker(system.content) },\n    user,\n  ];\n\n  return request;\n}"
      },
      "ChatSquash": {
        "enabled": true,
        "conditional_enabled": true,
        "conditional_tag": "<|merge|>",
        "separate_chat_history": false,
        "parse_clewd": false,
        "user_role_system": false,
        "role": "assistant",
        "enable_stop_string": false,
        "stop_string": "[\"<end>\", \"<ctrl\", \"<thought>\"]",
        "user_prefix": "|{{user}}|\n",
        "user_suffix": "",
        "char_prefix": "|游戏剧情|\n",
        "char_suffix": "",
        "prefix_system": "",
        "suffix_system": "",
        "enable_squashed_separator": true,
        "squashed_separator_regex": false,
        "squashed_separator_string": "<|sep|>",
        "squashed_post_script_enable": true,
        "squashed_post_script": "content => {\n  const usernameRegex = /\\|用户：(.*?)\\|/;\n\n  const usernameMatches = content.match(usernameRegex);\n  let username = '用户';\n  if (usernameMatches && usernameMatches.length > 1) {\n    username = usernameMatches[1];\n  }\n\n  content = content.replace(usernameRegex, '');\n\n  const deleteRegex = /\\|delete\\|[\\s\\S]*?\\|\\/delete\\|/g;\n  let result = content.replace(deleteRegex, '');\n\n  let prev = null; // 'cat' | 'user' | null\n  const re = /[\\n]*\\|(小猫之神|用户)\\|/g;\n\n  // 处理 summary 标签，插入剧情总结标记\n  // 找到所有独立的 <summary>（前面没有 details）\n  const summaryPositions = [];\n  const summaryRegex = /<summary>/g;\n  let summaryMatch;\n\n  while ((summaryMatch = summaryRegex.exec(result)) !== null) {\n    const index = summaryMatch.index;\n    // 检查前面是否紧跟着 details>（排除 <details><summary> 的情况）\n    const before = result.substring(Math.max(0, index - 10), index);\n    if (!/details>\\s*$/.test(before)) {\n      summaryPositions.push(index);\n    }\n  }\n\n  // 排除最后四个，只处理前面的\n  const positionsToProcess = summaryPositions.slice(0, -3);\n\n  // 从后往前处理，避免索引偏移问题\n  for (let i = positionsToProcess.length - 1; i >= 0; i--) {\n    const pos = positionsToProcess[i];\n    const insertPos = pos + '<summary>'.length;\n    const insertText = `\\n---第${i + 1}段剧情总结---`;\n    result = result.substring(0, insertPos) + insertText + result.substring(insertPos);\n  }\n\n  return String(result).replace(re, (_, who) => {\n    const isCat = who === '小猫之神';\n    let replacement;\n\n    if (isCat) {\n      replacement = `\\n\"}, {\"role\": \"soliumbra\", \"content\": \"\\n`;\n      prev = 'cat';\n    } else {\n      const prefix = prev === 'cat' ? '<end>' : '';\n      replacement = `\\n\"}, {\"role\": \"${username}\", \"content\": \"\\n`;\n      prev = 'user';\n    }\n\n    return replacement;\n  });\n};\n",
        "re_split": false
      }
