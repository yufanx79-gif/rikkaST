        "toolCallFormatter": {
          "enabled": true,
          "script": "({ calls }) => calls.map(call => \n  call.name === 'soliumbra_think' ? `<think_nya~>\\n${call.arguments.thinking}\\n</think_nya~>` : call.arguments.content).join('\\n');"
